{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "Build STM32",
        "type": "shell",
        "command": "make",
        "args": [
            "-j8"
        ],
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "group": {
            "kind": "build",
            "isDefault": true
        },
        "problemMatcher": [
            "$gcc"
        ]
    },
    {
        "label": "Clean STM32",
        "type": "shell",
        "command": "make",
        "args": [
            "clean"
        ],
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "group": "build"
    },
    {
        "label": "Flash STM32 (OpenOCD)",
        "type": "shell",
        "command": "openocd",
        "args": [
            "-f", "interface/stlink.cfg",
            "-f", "target/stm32f4x.cfg",
            "-c", "program build/blink_make.elf verify reset exit"
        ],
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "dependsOn": "Build STM32"
    },
  ]
}